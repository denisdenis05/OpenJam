{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "declaration": true,
    "outDir": ".build",
    "rootDir": ".",
    "types": [],
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "react": [
        "../StreamingServiceMobile/node_modules/@types/react"
      ],
      "react-native": [
        "../StreamingServiceMobile/node_modules/react-native"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "contracts/**/*.ts"
  ]
}
